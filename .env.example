# ─── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Database (Supabase Postgres, pooled + direct) ─────
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ─── Supabase ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="gloves-platform"

# ─── Better Auth ────────────────────────────────────────
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUST_HOST=true

# ─── Email (Resend) ─────────────────────────────────────
# NOTE on RESEND_FROM_EMAIL: Resend's shared test address
# (onboarding@resend.dev) works with zero setup, but Resend restricts it
# to delivering ONLY to the email address you signed up to Resend with —
# every other recipient is silently rejected until you verify your own
# sending domain (Resend dashboard -> Domains -> Add Domain, then set DNS
# records). If you're testing registration/RFQ forms with a *different*
# email address than your Resend account's own email, this is almost
# certainly why nothing arrives. Check the Resend dashboard -> Emails tab
# for the actual per-send delivery status/error either way.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"
ADMIN_NOTIFICATION_EMAIL="sales@yourdomain.com"

# ─── Rate Limiting (optional: Upstash Redis) ────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Analytics ──────────────────────────────────────────
NEXT_PUBLIC_VERCEL_ANALYTICS="true"
